{
  "name": "kouza-enquete",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute kouza-enquete-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute kouza-enquete-db --remote --file=./schema.sql",
    "db:migrate:local:002": "wrangler d1 execute kouza-enquete-db --local --file=./migrations/002_treatment_survey.sql",
    "db:migrate:remote:002": "wrangler d1 execute kouza-enquete-db --remote --file=./migrations/002_treatment_survey.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
